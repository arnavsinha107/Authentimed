# ==========================================
# Authentimed Backend Environment Variables
# ==========================================

# Ethereum Sepolia RPC URL (Infura, Alchemy, or Public RPC)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

# Deployer / Manufacturer Private Key (hex string without 0x prefix if required by Web3)
PRIVATE_KEY=your_private_key_here

# Supabase / PostgreSQL Connection String
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require

# Flask Server Port (Default: 5001)
PORT=5001
